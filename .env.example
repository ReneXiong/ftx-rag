# Copy to .env and adjust.

# Where metadata.jsonl lives and where every stage writes its output.
FTX_RAG_DATA_DIR=data

# ── LLM: any OpenAI-compatible endpoint (vLLM, llama.cpp, Ollama, hosted APIs)
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=qwen3:8b
# Extra request fields as JSON, e.g. to switch off reasoning for extraction:
#   vLLM / llama.cpp:  {"chat_template_kwargs": {"enable_thinking": false}}
#   some gateways:     {"thinking": {"type": "disabled"}}
# LLM_EXTRA_BODY=

# Optional: a different model for generating eval questions.
# EVAL_BASE_URL=
# EVAL_API_KEY=
# EVAL_MODEL=

# ── Embedding / reranking (run locally via sentence-transformers)
# EMBEDDING_MODEL=Qwen/Qwen3-Embedding-4B
# EMBEDDING_DIM=1536
# To keep all 2560 dims, use halfvec indexes:
#   EMBEDDING_DIM=2560
#   POSTGRES_VECTOR_INDEX_TYPE=HNSW_HALFVEC
# RERANKER_MODEL=Qwen/Qwen3-Reranker-4B
# RERANKER_ENABLED=1

# Only the first N characters of each document go into the graph (0 = no cap).
# MAX_GRAPH_DOC_CHARS=400000

# ── PostgreSQL + pgvector (see docker-compose.yml)
PG_HOST=localhost
PG_PORT=5432
PG_USER=ftxrag
PG_PASSWORD=ftxrag_dev
PG_DATABASE=ftxrag
